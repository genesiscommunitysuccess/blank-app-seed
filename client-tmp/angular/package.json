{
  "name": "{{pkgName}}",
  "description": "",
  "version": "{{applicationVersionWeb}}",
  "private": true,
  "license": "UNLICENSED",
  "genx": {
    "app": {
      "rootElement": "{{rootElement}}"
    },
    "eventTypes": {
      "enabled": true,
      "serverModule": "../server/{{appName}}-app",
      "output": "src/generated/genesis-event-types.ts",
      "runOnBuild": true
    }
  },
  "scripts": {
    "baseline": "npm run clean && npm run bootstrap",
    "bootstrap": "npm install --no-fund --no-audit",
    "bootstrap:ci": "npm ci --no-fund --no-audit",
    "build": "ng build --configuration=production",
    "build:stats": "npm run build --stats-json",
    "clean": "genx clean dist node_modules",
    "dev": "ng serve --configuration=development --open",
    "dev:docker": "npm run dev -- --host 0.0.0.0",
    "dev:no-open": "npm run dev -- --no-open",
    "dev:intellij": "npm run dev",
    "dev:https": "npm run dev -- --https",
    "dev:webpack": "npm run dev",
    "git:setup": "cd .. && npx --no --prefix client husky install",
    "lint": "genx lint -l ox",
    "lint:fix": "genx lint -l ox --fix",
    "lint:stylelint": "node lint-css.js",
    "test": "jest",
    "test:e2e": "genx test --e2e",
    "test:e2e:debug": "genx test --e2e --debug",
    "test:e2e:ui": "genx test --e2e --interactive",
    "test:coverage": "ng test --no-watch --code-coverage",
    "test:unit:watch": "ng test --watch"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write"
    ],
    "*.{mjs,cjs}": [
      "oxfmt --write"
    ]
  },
  "stylelint": {
    "extends": "@genesislcap/stylelint-config"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^18.0.0",
    "@angular-devkit/build-angular": "^18.0.4",
    "@angular/cli": "^18.0.4",
    "@angular/compiler-cli": "^18.0.4",
    "@genesislcap/design-system-configurator": "{{versions.UI}}",
    "@genesislcap/foundation-testing": "{{versions.UI}}",
    "@genesislcap/genx": "{{versions.UI}}",
    "@genesislcap/event-type-codegen": "{{versions.UI}}",
    "@genesislcap/build-kit": "{{versions.UI}}",
    "@genesislcap/oxlint-config": "{{versions.UI}}",
    "@genesislcap/stylelint-config": "{{versions.UI}}",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^29.5.13",
    "@types/numeral": "^2.0.5",
    "file-loader": "^6.2.0",
    "husky": "^7.0.4",
    "jasmine-core": "~5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.2.4",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^12.4.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.77.0",
    "svg-url-loader": "^8.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.4.5",
    "ts-node": "10.9.2",
    "dotenv": "16.4.5",
    "webpack": "5.94.0",
    "@types/node": "20.14.11"
  },
  "dependencies": {
    "@angular/animations": "^18.0.4",
    "@angular/common": "^18.0.4",
    "@angular/compiler": "^18.0.4",
    "@angular/core": "^18.0.4",
    "@angular/forms": "^18.0.4",
    "@angular/platform-browser": "^18.0.4",
    "@angular/platform-browser-dynamic": "^18.0.4",
