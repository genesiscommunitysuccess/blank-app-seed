<rapid-layout-region type="horizontal">
  <rapid-layout-region type="vertical">
  {{#each route.tiles}}
    {{#ifEquals @index 0}}
    <rapid-layout-item title="{{this.title}}">
      <{{kebabCase this.componentName}}></{{kebabCase this.componentName}}>
    </rapid-layout-item>
    {{/ifEquals}}
    {{#ifEquals @index 1}}
    <rapid-layout-item title="{{this.title}}">
      <{{kebabCase this.componentName}}></{{kebabCase this.componentName}}>
    </rapid-layout-item>
    {{/ifEquals}}
  {{/each}}
  </rapid-layout-region>
  {{#if route.tiles.[2]}}
  <rapid-layout-region type="vertical">
  {{#each route.tiles}}
    {{#ifEquals @index 2}}
    <rapid-layout-item title="{{this.title}}">
      <{{kebabCase this.componentName}}></{{kebabCase this.componentName}}>
    </rapid-layout-item>
    {{/ifEquals}}
    {{#ifEquals @index 3}}
    <rapid-layout-item title="{{this.title}}">
      <{{kebabCase this.componentName}}></{{kebabCase this.componentName}}>
    </rapid-layout-item>
    {{/ifEquals}}
  {{/each}}
  </rapid-layout-region>
  {{else}}
  <rapid-layout-region type="vertical"></rapid-layout-region>
  {{/if}}
</rapid-layout-region>
