/*
 * AI chat configuration for this application.
 *
 * The two key items are DELIBERATELY EMPTY. Supply the one your app uses from the environment that
 * starts the server, which keeps the key out of this project entirely:
 *
 *   GENESIS_SYSDEF_AI_ANTHROPIC_API_KEY=...    (docker run -e / compose environment:)
 *
 * A value set here would live in your source control. AI_ALLOWED_MODELS bounds which models the
 * chat may ask for, and AI_MAX_OUTPUT_TOKENS caps the output size a single call can request.
 */
systemDefinition {
    global {
        item(name = "AI_ANTHROPIC_API_KEY", value = "")
        item(name = "AI_GEMINI_API_KEY", value = "")
        item(name = "AI_ALLOWED_MODELS", value = "{{AI.allowedModels}}")
        item(name = "AI_MAX_OUTPUT_TOKENS", value = "{{AI.maxOutputTokens}}")
    }

    systems {
    }
}
